# ---------- Core ----------
APP_NAME="AI Recruiter"
# Public URL of the app, used in interview links sent to candidates (use your tunnel URL in dev).
BASE_URL=http://localhost:8000
# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# SQLite for local dev; PostgreSQL in production, e.g.
# DATABASE_URL=postgresql+psycopg://recruiter:recruiter@localhost:5432/recruiter
DATABASE_URL=sqlite:///./recruiter.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
# Default timezone for candidates without one (IANA name)
APP_TIMEZONE=UTC
# Set true when served over HTTPS
SESSION_HTTPS_ONLY=false

# ---------- Recruiter login ----------
RECRUITER_USERNAME=recruiter
# bcrypt hash; generate with: python -m scripts.hash_password
# Wrap in single quotes so the $ signs are kept literally.
RECRUITER_PASSWORD_HASH=''

# ---------- OpenRouter ----------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Any OpenRouter model id. Pick models that are good at following JSON instructions.
OUTREACH_MODEL=
INTERVIEW_MODEL=
# Optional; default to OUTREACH_MODEL / INTERVIEW_MODEL
BRIEFING_MODEL=
SUMMARY_MODEL=
LLM_TIMEOUT_SECONDS=60

# ---------- Outreach safety rails ----------
# auto = agent sends replies itself; review = recruiter approves each message
DEFAULT_SEND_MODE=auto
MAX_OUTBOUND_PER_CANDIDATE_PER_DAY=3
# In the candidate's local time. Messages due in quiet hours are queued until they end.
QUIET_HOURS_START=21:00
QUIET_HOURS_END=08:00
RECRUITER_NAME="the hiring team"
COMPANY_NAME="Our Company"
# Optional: also email the recruiter about no-shows, incomplete interviews and summaries
RECRUITER_NOTIFY_EMAIL=

# ---------- Email: SMTP (send) + IMAP (receive) ----------
# Leave SMTP_HOST empty to use the console adapter (messages are logged, not sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=
EMAIL_FROM_NAME="AI Recruiter"
# Leave IMAP_HOST empty to disable inbox polling.
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_POLL_SECONDS=60

# ---------- SMS: Twilio ----------
# Leave empty to use the console adapter.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VALIDATE_SIGNATURE=true

# ---------- Interviews ----------
INTERVIEW_GRACE_BEFORE_MINUTES=10
INTERVIEW_GRACE_AFTER_MINUTES=30
INTERVIEW_NO_SHOW_MINUTES=30
INTERVIEW_ABANDON_MINUTES=15
INTERVIEW_MAX_MINUTES=30
INTERVIEW_MAX_QUESTIONS=8
# Minutes before start to send a reminder; 0 disables
INTERVIEW_REMINDER_MINUTES=30

# ---------- Interview voice: Gnani (optional) ----------
# Speech-to-text and read-aloud in the interview chat. Leave the key empty to hide the voice controls.
# Key from https://app.gnani.ai/voice/ . The voice must belong to the model's catalog
# (timbre-v2.5 English voices: Kaveri, Trupti, Devika, Pranav, Shlok, Girish).
GNANI_API_KEY=
GNANI_LANGUAGE=en-IN
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Kaveri

# ---------- Background jobs ----------
# Run the scheduler in exactly ONE process.
RUN_SCHEDULER=true
